# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rpa_assets
POSTGRES_USER=rpa
POSTGRES_PASSWORD=rpa_secret_change_me

# Application
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# Mock legacy API
LEGACY_API_HOST=legacy-api
LEGACY_API_PORT=8001
LEGACY_API_URL=http://legacy-api:8001

# Sensor simulator
SENSOR_API_HOST=sensor-sim
SENSOR_API_PORT=8002
SENSOR_API_URL=http://sensor-sim:8002

# Scheduling (cron expressions)
SCHEDULE_FILE_BOT=*/2 * * * *
SCHEDULE_API_BOT=*/3 * * * *
SCHEDULE_SENSOR_BOT=*/1 * * * *
SCHEDULE_MANUAL_BOT=*/5 * * * *

# Paths
DROP_FOLDER=/app/data/drop
ARCHIVE_FOLDER=/app/data/archive
MANUAL_FOLDER=/app/data/manual
LOG_FOLDER=/app/logs
